# Copy to `.env.local` and fill in before deploying.
# All three are read at build time, so set them in your hosting provider's
# environment settings as well as locally.

# Public origin of the site. Drives canonical URLs, the sitemap and social
# previews. Falls back to an RFC 2606 reserved domain when unset, which is
# intentional: an unconfigured deploy must never emit someone else's URL.
NEXT_PUBLIC_SITE_URL=https://alltools.example.com

# Google AdSense publisher id, e.g. "ca-pub-0000000000000000".
# Ads are disabled everywhere until this is set to a real `ca-pub-` value.
NEXT_PUBLIC_ADSENSE_CLIENT=

# Address shown on the contact page. The mailto link is hidden until set.
NEXT_PUBLIC_CONTACT_EMAIL=
