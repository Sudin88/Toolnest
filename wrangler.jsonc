{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "toolnest",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-11-10",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "routes": [
    {
      // The public hostname. `alltools.indevs.in` is its own zone in this
      // account, so Cloudflare creates the proxied DNS record and the edge
      // certificate for it when the worker is deployed — no record to add by
      // hand. Declaring a route leaves `workers_dev` unset, which disables the
      // `*.workers.dev` URL, so this domain is the worker's only address.
      "pattern": "alltools.indevs.in",
      "custom_domain": true
    }
  ],
  "services": [
    {
      // The worker calls itself to read the incremental cache and to run the
      // image loader. The service name must match `name` above.
      "binding": "WORKER_SELF_REFERENCE",
      "service": "toolnest"
    }
  ],
  "observability": {
    "enabled": true
  },
  "placement": {
    // Run the worker close to the assets it serves rather than only at the
    // origin the request happened to arrive at.
    "mode": "smart"
  }
}
